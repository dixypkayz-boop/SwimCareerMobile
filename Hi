            const totalCost = i.cost * actualQty;
            const totalGain = i.val * actualQty;
            if(Game.state.player.money < totalCost) {
                // can afford some but not all — just do max anyway since we clamped above
            }
            Game.state.player.money -= totalCost;
            const applyGain = (stat) => { Game.state.player.stats[stat] = +(Game.state.player.stats[stat] + totalGain).toFixed(2); };
            if(i.type==='all') { applyGain('strength'); applyGain('technique'); applyGain('endurance'); applyGain('mental'); }
            else { applyGain(i.type); }
            Game.save();
            UI.updateDashboard();
