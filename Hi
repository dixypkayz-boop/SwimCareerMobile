        renderHistory: function(crs) { const c = document.getElementById('pb-container'); let h = `<table class="data-table"><tr><th>Event</th><th>${crs} Best</th><th>Actions</th></tr>`; CONSTANTS.ALL_EVENTS.forEach(e => { let pb = Game.state.pbs[crs][e] ? Helpers.formatTime(Game.state.pbs[crs][e]) : "-"; let hist = Game.state.history[e] ? Game.state.history[e].filter(r => r.course === crs) : []; let count = hist.length; let btn = count >= 1 ? `<button class="btn btn-info" style="padding:4px 8px; font-size:0.7rem; width:auto;" onclick="UI.renderProgressionChart('${e}', '${crs}')">View Graph</button>` : `<small style="color:#999">No data</small>`; h += `<tr><td>${e}</td><td>${pb}</td><td>${btn}</td></tr>`; }); c.innerHTML = h+"</table>"; },
        renderProgressionChart: function(event, course) {
            document.getElementById('modal-chart').classList.add('active');
            document.getElementById('prog-title').innerText = `${event} (${course}) Progression`;
            document.getElementById('chart-splits-panel').style.display = 'none';
            const container = document.getElementById('chart-area');
            container.innerHTML = "Loading...";
            setTimeout(() => {
                if(!Game.state.history[event]) { container.innerHTML = "No history found."; return; }
                const data = Game.state.history[event].filter(r => r.course === course);
                if(data.length < 2) { container.innerHTML = `<div style="display:flex;justify-content:center;align-items:center;height:100%;color:#666;text-align:center;">Not enough data points to graph.<br>Race more to see your improvement!</div>`; return; }
                const w = container.clientWidth || 320; const h = container.clientHeight || 260;
                const pad = 48; const drawW = w - pad*2; const drawH = h - pad*2;
                let times = data.map(d => d.time); let minT = Math.min(...times); let maxT = Math.max(...times);
                let range = maxT - minT; if(range < 1) range = 1;
                // Build SVG with polyline + axis labels
                let points = ""; let dotData = [];
                data.forEach((d, i) => {
                    let x = pad + (i / Math.max(data.length-1,1)) * drawW;
                    let normalized = (d.time - minT) / range;
                    let y = pad + normalized * drawH;
                    points += `${x},${y} `;
                    dotData.push({ x, y, d });
                });
                let grid = `<line x1="${pad}" y1="${pad}" x2="${pad}" y2="${h-pad}" class="chart-grid"/>
                    <line x1="${pad}" y1="${h-pad}" x2="${w-pad}" y2="${h-pad}" class="chart-grid"/>
                    <text x="${pad-5}" y="${pad+4}" text-anchor="end" class="chart-label">${Helpers.formatTime(minT)}</text>
                    <text x="${pad-5}" y="${h-pad}" text-anchor="end" class="chart-label">${Helpers.formatTime(maxT)}</text>`;
                let svgDots = dotData.map((pt,i) => `<circle id="chartdot-${i}" cx="${pt.x}" cy="${pt.y}" class="chart-dot" r="7"/>`).join('');
                let svg = `<svg width="100%" height="100%" viewBox="0 0 ${w} ${h}">${grid}<polyline points="${points}" class="chart-line"/>${svgDots}</svg>`;
                container.innerHTML = svg;
                // Attach click/tap handlers to each dot
                dotData.forEach((pt, i) => {
                    const el = document.getElementById(`chartdot-${i}`);
                    if(!el) return;
                    el.addEventListener('click', () => {
                        // Highlight selected dot
                        document.querySelectorAll('.chart-dot').forEach(d => d.setAttribute('r', '7'));
                        el.setAttribute('r', '11');
                        const d = pt.d;
                        const panel = document.getElementById('chart-splits-panel');
                        panel.style.display = 'block';
                        let html = `<div style="font-weight:bold; margin-bottom:6px;">${Helpers.formatTime(d.time)} — ${d.meet || ''} (${d.date || ''}, Age ${d.age})</div>`;
                        if(d.splits && d.splits.length > 0) {
                            html += `<div style="display:flex; flex-wrap:wrap; gap:5px;">`;
                            let cumulative = 0;
                            d.splits.forEach((s, si) => {
                                cumulative += s;
                                html += `<div style="background:#fff; border-radius:6px; padding:4px 8px; border:1px solid #ddd; min-width:60px; text-align:center;"><div style="font-size:0.7rem; color:#999;">Lap ${si+1}</div><div style="font-weight:bold;">${s.toFixed(2)}s</div><div style="font-size:0.7rem; color:#888;">${Helpers.formatTime(cumulative)}</div></div>`;
                            });
                            html += `</div>`;
                        } else { html += `<div style="color:#999;">Splits not available for this swim (older record)</div>`; }
                        panel.innerHTML = html;
                    });
                });
            }, 50);
        },
