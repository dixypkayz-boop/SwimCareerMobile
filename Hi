        eventName:'', legDist:100, strokes:[], playerLeg:0, course:'LCM', poolLength:50,
        // Runtime
        active:false, interval:null, currentLeg:0,
        lanePos:[], laneSpeeds:[], laneDone:[],
        legSplits:[], totalTime:[],
        legStartTimer:0, playerLegTime:0,
        // Takeover
        takeoverWindow:false, takeoverDone:false,
        // Player physics
        pPos:0, pSpeed:0, pStam:100, pMult:1.0, pBasePace:0,
        pDived:false, _raceStartTs:0, lastSwimInput:0,
        currentLap:0, turnWindow:false, turnDone:false, dq:false, timer:0,
        // Display
        teamNames:[], playerLane:4,
        _boundInput:null,

        start: function(eventName, course, round) {
            this.eventName = eventName;
            this.course = course;
            this.round = round || 'Final';
            this.poolLength = course === 'SCM' ? 25 : 50;

            if(eventName === '4x100 Free Relay')      { this.legDist=100; this.strokes=['Free','Free','Free','Free']; }
            else if(eventName === '4x200 Free Relay') { this.legDist=200; this.strokes=['Free','Free','Free','Free']; }
            else                                       { this.legDist=100; this.strokes=['Back','Breast','Fly','Free']; }

            // Assign player leg: best stroke for medley, anchor for free
            if(eventName === '4x100 Medley Relay') {
                const aff = Game.state.player.strokeAffinity || {};
                const best = ['Back','Breast','Fly','Free'].reduce((a,b) => ((aff[a]||0) >= (aff[b]||0)) ? a : b);
                this.playerLeg = ['Back','Breast','Fly','Free'].indexOf(best);
            } else {
                this.playerLeg = 3;
            }

            // Team names — player's country at playerLane index
            this.playerLane = 4;
            const countries = ['USA','AUS','CHN','GBR','FRA','GER','JPN','NED','BRA','CAN','ITA','HUN','RUS','NZL','SWE'];
            this.teamNames = countries.slice(0,8);
            this.teamNames[this.playerLane] = Game.state.player.country;

            // WR reference for seeding AI speeds
            const legEventKey = this.legDist + 'm Free';
            const wr = Game.state.worldRecords[course][legEventKey]?.t || (this.legDist === 100 ? 47 : 105);
            const meetType = MEET_SCHEDULE[Game.state.calendar.monthIndex].type;
            const spread = meetType==='div'?1.12 : meetType==='prov'?1.07 : meetType==='western'?1.04 : meetType==='national'?1.018 : 1.008;

            this.laneSpeeds = Array.from({length:8}, () =>
                Array.from({length:4}, (_,leg) => {
                    const stroke = this.strokes[leg];
                    const pen = stroke==='Breast'?0.88 : stroke==='Fly'?0.94 : stroke==='Back'?0.96 : 1.0;
                    const teamBase = wr * (1.0 + Math.random()*(spread-1.0));
                    return this.legDist / (teamBase / pen * (0.97 + Math.random()*0.06));
                })
            );

            // Reset all runtime state
            this.currentLeg=0; this.timer=0; this.dq=false;
            this.lanePos=Array(8).fill(0); this.laneDone=Array(8).fill(false);
            this.legSplits=Array.from({length:8},()=>Array(4).fill(0));
            this.totalTime=Array(8).fill(0);
            this.takeoverWindow=false; this.takeoverDone=false;
            this.pDived=false; this.active=false;

            this._showBriefing();
        },

        _showBriefing: function() {
            const legNames = ['FIRST','SECOND','THIRD','ANCHOR'];
            const stroke = this.strokes[this.playerLeg];
            const icons = {Free:'🏊',Back:'🔄',Breast:'🤸',Fly:'🦋'};

            const orderHTML = this.strokes.map((s,i) => {
                const isP = i===this.playerLeg;
                return `<div style="display:flex;flex-direction:column;align-items:center;gap:3px;opacity:${isP?1:0.45}">
                    <div style="width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.3rem;
                        background:${isP?'var(--primary)':'#e0e0e0'};color:${isP?'white':'#666'};
                        border:${isP?'3px solid var(--accent)':'2px solid #ccc'}">${icons[s]||'🏊'}</div>
                    <div style="font-size:0.62rem;font-weight:700;color:${isP?'var(--primary)':'#999'}">LEG ${i+1}</div>
                    <div style="font-size:0.58rem;color:#888">${s}</div>
                    ${isP?`<div style="font-size:0.58rem;background:var(--accent);color:#333;padding:1px 6px;border-radius:8px;font-weight:800">YOU</div>`:''}
                </div>`;
            }).join('<div style="font-size:1.2rem;color:#ccc;align-self:center;padding-bottom:12px">→</div>');

            // Remove old briefing if exists
            const old = document.getElementById('modal-relay-brief');
            if(old) old.remove();

            const modal = document.createElement('div');
            modal.id = 'modal-relay-brief';
            modal.className = 'modal-backdrop active';
            modal.innerHTML = `<div class="modal-body" style="text-align:center;max-width:520px">
                <div style="font-size:2.5rem;margin-bottom:6px">${icons[stroke]||'🏊'}</div>
                <h2 style="color:var(--primary);margin:0 0 4px">${this.eventName}</h2>
                <div style="color:#666;margin-bottom:16px;font-size:0.9rem">${Game.getCurrentMeet().name} — ${this.round.toUpperCase()}</div>
                <div style="display:flex;justify-content:center;align-items:center;gap:10px;margin-bottom:18px;flex-wrap:wrap">${orderHTML}</div>
                <div style="background:linear-gradient(135deg,#e3f2fd,#bbdefb);border-radius:12px;padding:14px 18px;margin-bottom:20px;border-left:4px solid var(--primary);text-align:left">
                    <div style="font-weight:900;font-size:1rem;color:var(--primary)">YOU SWIM ${legNames[this.playerLeg]||'?'} LEG — ${stroke.toUpperCase()}</div>
                    <div style="font-size:0.82rem;color:#546e7a;margin-top:5px">
                        ${this.playerLeg===0
                            ? 'You start first. Press <b>SWIM</b> on the beep to dive in.'
                            : 'Watch the pool — when the incoming swimmer hits the wall, the <b>TAKEOVER!</b> cue fires. Hit <b>SWIM</b> fast for a great exchange.'}
                    </div>
                </div>
                <button onclick="Relay._startRace()" class="btn btn-primary" style="padding:14px 40px;font-size:1rem">🏊 Start Relay</button>
            </div>`;
            document.body.appendChild(modal);
        },

        _startRace: function() {
            const brief = document.getElementById('modal-relay-brief');
            if(brief) brief.remove();

            document.getElementById('ui-dashboard').style.display='none';
            document.getElementById('ui-race').style.display='flex';
            document.getElementById('mobile-controls').style.display='flex';
            document.getElementById('race-title-hud').innerText = this.eventName;
            document.getElementById('race-heat-hud').innerText = `RELAY ${this.round.toUpperCase()}`;
            document.getElementById('res-event-name') && (document.getElementById('res-event-name').innerText = this.eventName);

            this.active = true;
            this._prepLeg(0);

            this._boundInput = (e) => this._handleInput(e);
            window.addEventListener('keydown', this._boundInput);
            this.interval = setInterval(() => this._tick(), 50);
        },

        _prepLeg: function(leg) {
            this.currentLeg = leg;
            this.legTransitioning = false;
            this.lanePos = Array(8).fill(0);
            this.laneDone = Array(8).fill(false);
            this.pPos = 0; this.currentLap = 0;
            this.turnWindow = false; this.turnDone = false;
            this.takeoverWindow = false; this.takeoverDone = false;

            const stroke = this.strokes[leg];
            Race.strokeType = stroke;
            Race.poolLength = this.poolLength;
            Race.distance = this.legDist;

            // Build Race.lanes for renderPool
            Race.lanes = Array.from({length:8}, (_,i) => ({
                name: i===this.playerLane ? Game.state.player.shortName : this.teamNames[i],
                isPlayer: i===this.playerLane,
                pos:0, finished:false, finalTime:0, dq:false,
                raceSpeed: this.laneSpeeds[i][leg],
                aiDived: true, // all AI swimmers auto-swim; player controls their own
                aiReaction: 0,
            }));
            Race.renderPool();

            const isPlayerLeg = leg === this.playerLeg;

            if(isPlayerLeg) {
                // Player must press SWIM / do takeover to start their leg
                this.pDived = false;
                this.pStam = 100 + Game.state.player.stats.endurance * 2;
                this.pMult = 1.0;
                // Compute player pace for this leg
                const legEventKey = this.legDist + 'm ' + stroke;
                const safeEvent = CONSTANTS.ALL_EVENTS.includes(legEventKey) ? legEventKey : (this.legDist + 'm Free');
                const aff = Game.state.player.strokeAffinity || {};
                let baseTime = Race.calcBaseTime(safeEvent, this.course, Game.state.player.age, Game.state.player.stats, stroke, aff);
                const pen = stroke==='Breast'?0.88:stroke==='Fly'?0.94:stroke==='Back'?0.96:1.0;
                this.pBasePace = this.legDist / (baseTime / pen);

                const fb = document.getElementById('start-countdown');
                if(leg === 0) {
                    // Start sequence like a normal race
                    fb.innerText = 'TAKE YOUR MARKS'; fb.style.color='white';
                    fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
                    this._raceStartTs = 0; // will be set after "GO" fires
                    setTimeout(() => {
                        this.legStartTimer = this.timer;
                        fb.innerText = 'GO!'; fb.style.color='#00e676';
                        fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
                        this._raceStartTs = performance.now();
                    }, 1200 + Math.random()*800);
                } else {
                    // Waiting for takeover — legStartTimer set when takeover fires
                    fb.innerText = 'GET READY — WATCH INCOMING!'; fb.style.color='#ffd700';
                    fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
                    this.legStartTimer = this.timer; // rough start; overridden at actual takeover
                }
            } else {
                // Non-player leg: auto-swim player lane, no input needed
                this.pDived = true;
                this.pBasePace = this.laneSpeeds[this.playerLane][leg];
                this.legStartTimer = this.timer;
                const fb = document.getElementById('start-countdown');
                fb.innerText = `LEG ${leg+1} — WATCH`; fb.style.color='#90caf9';
                fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
            }
        },

        _handleInput: function(e) {
            if(!this.active) return;
            const isPlayerLeg = this.currentLeg === this.playerLeg;

            // Takeover window — SWIM button launches player
            if(this.takeoverWindow && !this.takeoverDone &&
               (e.code==='Space'||e.code==='ArrowLeft'||e.code==='ArrowRight')) {
                this._doTakeover(); return;
            }

            if(!isPlayerLeg) return;

            // Leg 0 start dive — wait for GO signal (_raceStartTs set)
            if(!this.pDived && this._raceStartTs > 0 &&
               (e.code==='ArrowLeft'||e.code==='ArrowRight'||e.code==='Space')) {
                this.pDived = true;
                const reaction = (performance.now() - this._raceStartTs) / 1000;
                this.pMult += reaction < 0.4 ? 0.06 : 0.02;
                this.legStartTimer = this.timer;
                Race.triggerDive(this.playerLane);
                return;
            }

            if(this.pDived) {
                if(e.code==='ArrowLeft'||e.code==='ArrowRight') this._inputSwim();
                if(e.code==='Space') this._inputTurn();
            }
        },

        _doTakeover: function() {
            this.takeoverDone = true;
            this.takeoverWindow = false;
            document.getElementById('turn-indicator-box').style.display='none';

            // Advance currentLeg to the player's leg so _tick drives player physics.
            // Reset lane positions — all swimmers start fresh for this leg.
            this.currentLeg = this.playerLeg;
            this.legTransitioning = false;
            this.lanePos = Array(8).fill(0);
            this.laneDone = Array(8).fill(false);
            this.pPos = 0; this.currentLap = 0;
            this.turnWindow = false; this.turnDone = false;

            const stroke = this.strokes[this.playerLeg];
            Race.strokeType = stroke;
            Race.poolLength = this.poolLength;
            Race.distance = this.legDist;
            Race.lanes = Array.from({length:8}, (_,i) => ({
                name: i===this.playerLane ? Game.state.player.shortName : this.teamNames[i],
                isPlayer: i===this.playerLane,
                pos:0, finished:false, finalTime:0, dq:false,
                raceSpeed: this.laneSpeeds[i][this.playerLeg],
                aiDived: true, aiReaction: 0,
            }));
            Race.renderPool();

            // Compute player pace (may not have been set if _prepLeg was skipped)
            if(!this.pBasePace || this.pBasePace <= 0) {
                const legEventKey = this.legDist + 'm ' + stroke;
                const safeEvent = CONSTANTS.ALL_EVENTS.includes(legEventKey) ? legEventKey : (this.legDist + 'm Free');
                const aff = Game.state.player.strokeAffinity || {};
                let baseTime = Race.calcBaseTime(safeEvent, this.course, Game.state.player.age, Game.state.player.stats, stroke, aff);
                const pen = stroke==='Breast'?0.88:stroke==='Fly'?0.94:stroke==='Back'?0.96:1.0;
                this.pBasePace = this.legDist / (baseTime / pen);
                this.pStam = 100 + Game.state.player.stats.endurance * 2;
            }

            this.pDived = true;
            this.pMult = 1.05; // great exchange bonus
            this.legStartTimer = this.timer;
            Race.triggerDive(this.playerLane);
            const fb = document.getElementById('start-countdown');
            fb.innerText='GO!'; fb.style.color='#00e676';
            fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
        },

        _inputSwim: function() {
            const now = Date.now();
            if(now-(this.lastSwimInput||0) < 220) return;
            this.lastSwimInput = now;
            const s = Game.state.player.stats;
            let bonus = 0.012 + Math.min(s.technique,60)*0.0003;
            if(this.pStam < 20) bonus *= 0.4;
            this.pMult = Math.min(this.pMult+bonus, 1.0+Math.min(0.18,0.08+s.technique*0.0015));
            this.pStam -= 0.45;
        },

        _inputTurn: function() {
            if(this.turnWindow && !this.turnDone) {
                this.turnDone = true;
                this.pMult += 0.04 + Game.state.player.stats.mental*0.001;
                this.pStam += 4;
                document.getElementById('turn-indicator-box').style.display='none';
                const fb = document.getElementById('start-countdown');
                fb.innerText='TURN!'; fb.style.color='white';
                fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
                setTimeout(()=>{ this.turnWindow=false; },200);
            }
        },

        _tick: function() {
            if(!this.active) return;
            const dt = 0.05 * CONSTANTS.GAME_SPEED_MULTIPLIER;
            this.timer += dt;

            const isPlayerLeg = this.currentLeg === this.playerLeg;

            // ── Takeover trigger: show cue when player-lane incoming swimmer is <3m from wall ──
            if(!isPlayerLeg && this.currentLeg === this.playerLeg - 1 && !this.takeoverDone) {
                if(this.lanePos[this.playerLane] >= this.legDist - 3.5) {
                    if(!this.takeoverWindow) {
                        this.takeoverWindow = true;
                        document.getElementById('turn-indicator-box').style.display='block';
                        const fb = document.getElementById('start-countdown');
                        fb.innerText='TAKEOVER!'; fb.style.color='#ffd700';
                        fb.classList.remove('feedback-pop'); void fb.offsetWidth; fb.classList.add('feedback-pop');
                    }
                }
            }

            // ── Player physics on their leg ──
            if(isPlayerLeg && this.pDived) {
                this.pMult += (1.0-this.pMult)*0.04;
                if(this.pStam<25&&this.pMult>1.0) this.pMult-=(this.pMult-1.0)*0.06;
                if(this.pStam<=0){ this.pStam=0; if(this.pMult>0.85) this.pMult-=(this.pMult-0.85)*0.08; }
                if(this.pMult<1.0) this.pStam=Math.min(100+Game.state.player.stats.endurance*2,this.pStam+0.15);
                this.pPos += this.pBasePace * this.pMult * dt;
                this.pSpeed = this.pBasePace * this.pMult;
                // Lap turns
                const lap = Math.floor(this.pPos/this.poolLength);
                if(lap>this.currentLap){ this.currentLap=lap; if(this.pPos<this.legDist){ this.turnDone=false; Race.triggerTurn(); } }
                this.lanePos[this.playerLane] = Math.min(this.legDist, this.pPos);
                Race.lanes[this.playerLane].pos = this.lanePos[this.playerLane];
                if(this.lanePos[this.playerLane] >= this.legDist && !this.laneDone[this.playerLane]) {
                    this.laneDone[this.playerLane] = true;
                    this.playerLegTime = this.timer - this.legStartTimer;
                    this.legSplits[this.playerLane][this.currentLeg] = this.playerLegTime;
                }
            } else if(!isPlayerLeg) {
                // Auto-swim player lane on non-player legs
                if(!this.laneDone[this.playerLane]) {
                    this.lanePos[this.playerLane] = Math.min(this.legDist, this.lanePos[this.playerLane]+this.laneSpeeds[this.playerLane][this.currentLeg]*dt);
                    Race.lanes[this.playerLane].pos = this.lanePos[this.playerLane];
                    this.pSpeed = this.laneSpeeds[this.playerLane][this.currentLeg];
                    if(this.lanePos[this.playerLane]>=this.legDist) {
                        this.laneDone[this.playerLane]=true;
                        this.legSplits[this.playerLane][this.currentLeg]=this.timer-this.legStartTimer;
                    }
                }
            }

            // ── AI lanes ──
            for(let i=0;i<8;i++){
                if(i===this.playerLane) continue;
                if(!this.laneDone[i]){
                    this.lanePos[i]=Math.min(this.legDist,this.lanePos[i]+this.laneSpeeds[i][this.currentLeg]*dt);
                    Race.lanes[i].pos=this.lanePos[i];
                    if(this.lanePos[i]>=this.legDist){
                        this.laneDone[i]=true;
                        this.legSplits[i][this.currentLeg]=this.timer-this.legStartTimer;
                    }
                }
            }

            // ── Check all lanes finished this leg ──
            if(this.laneDone.every(d=>d) && !this.legTransitioning) {
                this.legTransitioning = true;
                for(let i=0;i<8;i++) this.totalTime[i]+=this.legSplits[i][this.currentLeg];

                const nextLeg = this.currentLeg + 1;
                if(nextLeg > 3) {
                    this._finish();
                } else if(nextLeg === this.playerLeg) {
                    // The leg immediately before the player's leg just finished.
                    // Compute player pace now, show GET READY, then wait for takeover input.
                    const stroke = this.strokes[this.playerLeg];
                    const legEventKey = this.legDist + 'm ' + stroke;
                    const safeEvent = CONSTANTS.ALL_EVENTS.includes(legEventKey) ? legEventKey : (this.legDist + 'm Free');
                    const aff = Game.state.player.strokeAffinity || {};
                    let baseTime = Race.calcBaseTime(safeEvent, this.course, Game.state.player.age, Game.state.player.stats, stroke, aff);
                    const pen = stroke==='Breast'?0.88:stroke==='Fly'?0.94:stroke==='Back'?0.96:1.0;
                    this.pBasePace = this.legDist / (baseTime / pen);
                    this.pStam = 100 + Game.state.player.stats.endurance * 2;
                    this.pMult = 1.0;
                    this.pDived = false;
                    this.takeoverWindow = true;
                    this.takeoverDone = false;
                    document.getElementById('turn-indicator-box').style.display='block';
                    const fb2 = document.getElementById('start-countdown');
                    fb2.innerText='TAKEOVER! HIT SWIM!'; fb2.style.color='#ffd700';
                    fb2.classList.remove('feedback-pop'); void fb2.offsetWidth; fb2.classList.add('feedback-pop');
                    // Don't advance currentLeg — _doTakeover will do that when player acts
                } else {
                    setTimeout(()=>this._prepLeg(nextLeg), 400);
                }
                return;
            }

            // ── HUD ──
            document.getElementById('race-time-disp').innerText = Helpers.formatTime(this.timer);
            document.getElementById('hud-speed').innerText = this.pSpeed.toFixed(1);
            document.getElementById('hud-dist').innerText = `L${this.currentLeg+1} ${Math.floor(isPlayerLeg?this.pPos:this.lanePos[this.playerLane])}m`;
            document.getElementById('hud-stamina').style.width = isPlayerLeg
                ? Math.max(0,(this.pStam/(100+Game.state.player.stats.endurance*2))*100)+'%'
                : '100%';

            // ── Render swimmer positions ──
            const W = document.getElementById('pool-stage').clientWidth;
            for(let i=0;i<8;i++){
                const pos = this.lanePos[i];
                const lap=Math.floor(pos/this.poolLength);
                const distInLap=pos%this.poolLength;
                const isOdd=lap%2!==0;
                const pct=distInLap/this.poolLength;
                const px=40+((isOdd?1.0-pct:pct)*(W-80));
                const el=document.getElementById(`sw-${i}`);
                if(el) el.style.transform=`translate3d(${px}px,-50%,0) rotate(${isOdd?180:0}deg)`;
            }
        },

        _finish: function() {
            this.active=false;
            clearInterval(this.interval);
            window.removeEventListener('keydown', this._boundInput);
            document.getElementById('mobile-controls').style.display='none';
            document.getElementById('turn-indicator-box').style.display='none';
            setTimeout(()=>this._processRelayResults(), 800);
        },

        _processRelayResults: function() {
            document.getElementById('ui-race').style.display='none';

            const results = Array.from({length:8},(_,i)=>({
                team: this.teamNames[i],
                isPlayer: i===this.playerLane,
                totalTime: this.totalTime[i]||99,
                splits: this.legSplits[i].slice(),
            }));
            results.sort((a,b)=>a.totalTime-b.totalTime);
            const pResult = results.find(r=>r.isPlayer);
            const pRank = results.indexOf(pResult)+1;

            const meetType=MEET_SCHEDULE[Game.state.calendar.monthIndex].type;
            const isPrelim = (this.round === 'Prelim');
            const advancedToFinal = isPrelim && pRank <= 4; // top 4 relay teams advance

            // Save relay history (only for finals or dev meets)
            if(!isPrelim) {
                if(!Game.state.relayHistory) Game.state.relayHistory=[];
                Game.state.relayHistory.push({
                    event:this.eventName, meet:Game.getCurrentMeet().name,
                    year:Game.state.calendar.year, age:Game.state.player.age,
                    course:this.course, rank:pRank,
                    totalTime:pResult.totalTime,
                    playerSplit:pResult.splits[this.playerLeg],
                    playerLeg:this.playerLeg+1, stroke:this.strokes[this.playerLeg],
                    round: this.round,
                });
            }

            // Results table
            let html=`<table class="data-table"><tr><th>Rank</th><th>Team</th><th>Total Time</th><th>Your Split</th>${isPrelim?'<th>Status</th>':''}</tr>`;
            results.forEach((r,i)=>{
                let rowStyle = i===0?'background:#ffd700;color:#4e342e':i===1?'background:#e0e0e0':'';
                if(isPrelim) rowStyle = i<4?'background:#c8e6c9':'';
                const pStyle=r.isPlayer?'border-left:5px solid var(--primary);font-weight:bold;':'';
                const split=r.isPlayer?Helpers.formatTime(r.splits[this.playerLeg]):'—';
                const statusCell = isPrelim ? `<td style="font-size:0.8rem;font-weight:bold;color:${i<4?'var(--success)':'#999'}">${i<4?'✅ FINAL':'❌ Elim'}</td>` : '';
                html+=`<tr style="${rowStyle}${pStyle}"><td>${i+1}</td><td>${r.team}${r.isPlayer?' ⭐':''}</td><td>${Helpers.formatTime(r.totalTime)}</td><td>${split}</td>${statusCell}</tr>`;
            });
            html+='</table>';
            document.getElementById('res-table-container').innerHTML=html;
            if(document.getElementById('res-event-name')) document.getElementById('res-event-name').innerText=`${this.eventName} — ${this.round}`;
            document.getElementById('res-wr-alert').style.display='none';

            let msg=''; let xp=0; let money=0;
            const mMult=meetType==='div'?2:meetType==='prov'?5:meetType==='western'?10:meetType==='national'?50:meetType==='worlds'?500:1;

            if(isPrelim) {
                xp=20;
                if(advancedToFinal) {
                    msg=`RELAY PRELIM — Advanced to Final! (${pRank}${pRank===1?'st':pRank===2?'nd':pRank===3?'rd':'th'} place)`;
                } else {
                    msg=`RELAY PRELIM — Eliminated (${pRank}th). `;
                }
            } else {
                xp=50;
                if(pRank<=3){
                    const m=pRank===1?'Gold':pRank===2?'Silver':'Bronze';
                    msg=`RELAY ${m.toUpperCase()}! `;
                    money=(pRank===1?300:pRank===2?200:100)*mMult; xp+=80;
                    Game.state.medals.push({event:this.eventName,rank:m,meet:Game.getCurrentMeet().name,time:Helpers.formatTime(pResult.totalTime),year:Game.state.calendar.year,age:Game.state.player.age});
                } else { money=50*mMult; }
                msg+=`Your split: ${Helpers.formatTime(pResult.splits[this.playerLeg])}`;
            }
            document.getElementById('res-rewards').innerText=`${msg}  +$${money} +${xp} XP`;

            Game.addXp(xp); Game.state.player.money+=money;

            const btn=document.getElementById('btn-res-cont');

            if(isPrelim && advancedToFinal) {
                // Don't shift the queue — relay final coming next
                btn.innerText='Race Final';
                btn.onclick=()=>{
                    document.getElementById('modal-results').classList.remove('active');
                    Relay.start(this.eventName, this.course, 'Final');
                };
            } else {
                // Relay manages its own queue shift
                Game.state.raceQueue.shift();
                if(Game.state.raceQueue.length===0) Game.state.calendar.hasCompetedThisMonth=true;
                btn.innerText='Continue';
                btn.onclick=()=>{
                    document.getElementById('modal-results').classList.remove('active');
                    document.getElementById('ui-dashboard').style.display='flex';
                    UI.updateDashboard();
                };
            }

            Game.save();

            // Medal cutscene for national+ finals
            const curMeet=Game.getCurrentMeet();
            const bigMeet=meetType==='national'||meetType==='worlds'||curMeet.olympics;
            if(!isPrelim && pRank<=3 && bigMeet){
                Cutscene.show(pRank,curMeet.name,this.eventName,Helpers.formatTime(pResult.totalTime),Game.state.player.shortName,Game.state.player.age,!!curMeet.olympics,
                    ()=>document.getElementById('modal-results').classList.add('active'));
            } else {
                document.getElementById('modal-results').classList.add('active');
            }
        },
    };

    // Patch renderHistory to include relay splits at bottom
    const _origRenderHistory = UI.renderHistory.bind(UI);
    UI.renderHistory = function(crs) {
        _origRenderHistory(crs);
        if(!Game.state.relayHistory||Game.state.relayHistory.length===0) return;
        const c=document.getElementById('pb-container');
        let h=`<div style="margin-top:18px">
            <div style="font-size:0.7rem;font-weight:900;letter-spacing:0.12em;text-transform:uppercase;color:#0277bd;margin-bottom:8px">🏊 Relay Splits</div>
            <table class="data-table"><tr><th>Event</th><th>Meet</th><th>Leg</th><th>Your Split</th><th>Team Total</th><th>Finish</th></tr>`;
        Game.state.relayHistory.slice().reverse().forEach(r=>{
            const medal=r.rank===1?'🥇':r.rank===2?'🥈':r.rank===3?'🥉':`${r.rank}th`;
            h+=`<tr><td>${r.event}</td><td>${r.meet}</td><td>Leg ${r.playerLeg} (${r.stroke})</td>
                <td style="color:var(--primary);font-weight:bold">${Helpers.formatTime(r.playerSplit)}</td>
                <td>${Helpers.formatTime(r.totalTime)}</td><td>${medal}</td></tr>`;
        });
        h+='</table></div>';
        c.innerHTML+=h;
    };
</script>

