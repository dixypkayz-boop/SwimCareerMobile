        _shopBuy: function(id) {
            const i = SHOP_ITEMS.find(x => x.id === id);
            if(!i) return;
            if(Game.state.player.money < i.cost) { UI.showToast('Not enough money! Need $'+(i.cost-Game.state.player.money).toLocaleString()+' more.'); return; }
